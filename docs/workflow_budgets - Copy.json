{
    "version": "1.0.0",
    "provider": "openai",
    "currency": "USD",
    "pricing_mode": "token_estimate",
    "models": {
      "tier_a": { "name": "gpt-5-mini", "max_total_tokens_per_call": 2000 },
      "tier_b": { "name": "o4-mini", "max_total_tokens_per_call": 4000 },
      "tier_b2": { "name": "o3", "max_total_tokens_per_call": 6000 },
      "tier_c": { "name": "gpt-5.2", "max_total_tokens_per_call": 8000 }
    },
    "circuit_breaker": {
    "enabled": true,
  
    "monthly_budget_soft_usd": 3,
    "monthly_budget_hard_usd": 5,
  
    "rolling_24h_budget_hard_usd": 1.5,
  
    "tier_c_max_pct_24h": 0.05,
    "output_token_spike_factor": 2.0,
  
    "safe_mode": {
      "disable_tier_c": true,
      "preferred_tier": "tier_a",
      "output_cap_multiplier": 0.6,
      "queue_heavy_to_batch": true,
      "max_model_calls_override": 2
    }
  },
  
    "defaults": {
      "validation": {
        "require_json_schema": true,
        "confidence_threshold": 0.72,
        "fail_on_contradictions": true
      },
      "max_model_calls_global": 6,
      "stop_behaviors": ["PARTIAL_WITH_GAPS", "SPLIT_TASK", "FAIL_FAST"]
    },
    "workflows": {
      "compass_chat_qa": {
        "description": "Interactive Q&A: metric explanation, quick summaries",
        "max_model_calls": 2,
        "token_budget_total": 3000,
        "output_budget_total": 700,
        "allowed_tiers": ["tier_a", "tier_b"],
        "tier_call_limits": { "tier_a": 1, "tier_b": 1, "tier_b2": 0, "tier_c": 0 },
        "per_call_caps": {
          "tier_a": { "max_input": 1500, "max_output": 800, "max_total": 2000 },
          "tier_b": { "max_input": 1000, "max_output": 800, "max_total": 1000 }
        },
        "escalation_path": ["tier_a", "tier_b"],
        "escalation_triggers": ["LOW_CONFIDENCE", "SCHEMA_INVALID", "CONTRADICTION", "MISSING_REQUIRED_INPUTS"],
        "stop_behavior": "PARTIAL_WITH_GAPS"
