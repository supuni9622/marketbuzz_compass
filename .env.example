# API
PORT=3001
HOST=0.0.0.0

# Supabase (Postgres)
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Use service role for server-side (has full access)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AWS (Day 2+)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_UPLOADS=marketbuzz-compass-uploads
# S3_BUCKET_MEMORY=marketbuzz-compass-memory
# SQS (Day 3+): queue URL from AWS Console
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/marketbuzz-compass-ingestion

# Cognito (Day 2+)
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_REGION=us-east-1

# Web app (Next.js) — same Cognito + API URL
# NEXT_PUBLIC_COGNITO_DOMAIN=marketbuzz-compass.auth.us-east-1.amazoncognito.com
# NEXT_PUBLIC_COGNITO_CLIENT_ID= (same as COGNITO_CLIENT_ID)
# NEXT_PUBLIC_API_URL=http://localhost:3001
